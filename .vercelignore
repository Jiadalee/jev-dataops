# Deny by default. This deployment contains only the public static website,
# browser demo source, public metric definitions, and synthetic examples.
/*
!/.vercelignore
!/vercel.json
!/LICENSE

!/website
/website/*
!/website/index.html
!/website/guide
/website/guide/*
!/website/guide/index.html
!/website/metrics
/website/metrics/*
!/website/metrics/index.html
!/website/assets
/website/assets/*
!/website/assets/site.css
!/website/assets/site.js
!/website/assets/metrics.js
!/website/assets/metrics.css
!/website/assets/favicon.svg

!/scripts
/scripts/*
!/scripts/build_website.py
!/scripts/build_public_demo.py

!/jev_dataops
/jev_dataops/*
!/jev_dataops/static
/jev_dataops/static/*
!/jev_dataops/static/index.html
!/jev_dataops/static/styles.css
!/jev_dataops/static/app.js
!/jev_dataops/examples
/jev_dataops/examples/*
!/jev_dataops/examples/dialogues.jsonl
!/jev_dataops/metric_packs
/jev_dataops/metric_packs/*
!/jev_dataops/metric_packs/general.json
!/jev_dataops/metric_packs/finance.json
!/jev_dataops/metric_packs/code.json
!/jev_dataops/metric_packs/enterprise.json
!/jev_dataops/metric_packs/legal.json
!/jev_dataops/metric_packs/medical.json
!/jev_dataops/metric_examples
/jev_dataops/metric_examples/*
!/jev_dataops/metric_examples/general.jsonl
!/jev_dataops/metric_examples/finance.jsonl
!/jev_dataops/metric_examples/code.jsonl
!/jev_dataops/metric_examples/enterprise.jsonl
!/jev_dataops/metric_examples/legal.jsonl
!/jev_dataops/metric_examples/medical.jsonl

!/public_demo
/public_demo/*
!/public_demo/runtime.js
