# Deny by default. This deployment contains only the public static website,
# browser demo source, and one intentionally synthetic bundled example.
/*
!/.vercelignore
!/vercel.json
!/LICENSE

!/website
/website/*
!/website/index.html
!/website/guide
/website/guide/*
!/website/guide/index.html
!/website/assets
/website/assets/*
!/website/assets/site.css
!/website/assets/site.js
!/website/assets/favicon.svg

!/scripts
/scripts/*
!/scripts/build_website.py
!/scripts/build_public_demo.py

!/jev_dataops
/jev_dataops/*
!/jev_dataops/static
/jev_dataops/static/*
!/jev_dataops/static/index.html
!/jev_dataops/static/styles.css
!/jev_dataops/static/app.js
!/jev_dataops/examples
/jev_dataops/examples/*
!/jev_dataops/examples/dialogues.jsonl

!/public_demo
/public_demo/*
!/public_demo/runtime.js
