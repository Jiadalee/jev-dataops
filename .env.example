# Set these in the server process environment; .env is not loaded automatically.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
# Required for remote access. The frontend requests this shared operator token.
JEV_API_TOKEN=
JEV_ALLOWED_HOSTS=localhost,127.0.0.1
JEV_MAX_UPLOAD_MB=1024
JEV_BASE_MODEL=HuggingFaceTB/SmolLM2-135M
JEV_MODEL_LOCAL_ONLY=0
JEV_TRAIN_DEVICE=auto
